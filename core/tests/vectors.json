  {
    "id": "hlc-001",
    "kind": "hlc",
    "description": "HLC ordering is wall-first then counter then device_id",
    "input": {
      "hlc_a": {
        "counter": 0,
        "device_id_hex": "02020202020202020202020202020202",
        "wall": 1
      },
      "hlc_b": {
        "counter": 0,
        "device_id_hex": "01010101010101010101010101010101",
        "wall": 2
      }
    },
    "expected": {
      "b_greater_than_a": true
    }
  },
  {
    "id": "merge-001",
    "kind": "merge",
    "description": "Duplicate updates do not change the merged task",
    "input": {
      "actions": [
        {
          "hlc": {
            "counter": 0,
            "device_id_hex": "01010101010101010101010101010101",
            "wall": 1
          },
          "id_hex": "02020202020202020202020202020202",
          "kind": "Create",
          "quadrant": 0,
          "title": "A"
        },
        {
          "hlc": {
            "counter": 0,
            "device_id_hex": "01010101010101010101010101010101",
            "wall": 2
          },
          "id_hex": "02020202020202020202020202020202",
          "kind": "Update",
          "title": "B"
        },
        {
          "hlc": {
            "counter": 0,
            "device_id_hex": "01010101010101010101010101010101",
            "wall": 2
          },
          "id_hex": "02020202020202020202020202020202",
          "kind": "Update",
          "title": "B"
        }
      ]
    },
    "expected": {
      "title": "B"
    }
  },
  {
    "id": "merge-002",
    "kind": "merge",
    "description": "Dropping an update changes the merged title",
    "input": {
      "actions": [
        {
          "hlc": {
            "counter": 0,
            "device_id_hex": "01010101010101010101010101010101",
            "wall": 1
          },
          "id_hex": "03030303030303030303030303030303",
          "kind": "Create",
          "quadrant": 0,
          "title": "A"
        },
        {
          "hlc": {
            "counter": 0,
            "device_id_hex": "01010101010101010101010101010101",
            "wall": 2
          },
          "id_hex": "03030303030303030303030303030303",
          "kind": "Update",
          "title": "B"
        }
      ]
    },
    "expected": {
      "changed": true,
      "with_update_title": "B",
      "without_update_title": "A"
    }
  },
  {
