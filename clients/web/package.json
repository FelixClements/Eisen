{
  "name": "eisen-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler pages dev .svelte-kit/cloudflare",
    "deploy": "wrangler pages deploy .svelte-kit/cloudflare",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply eisen-web-db --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@sveltejs/adapter-cloudflare": "^6.0.0",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vite-pwa/sveltekit": "^0.6.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "better-auth": "^1.2.0",
    "dexie": "^4.0.0",
    "framework7-icons": "^5.0.0",
    "konsta": "^5.3.0",
    "kysely": "^0.27.0",
    "kysely-d1": "^0.4.0",
    "web-push": "^3.6.0"
  }
}
